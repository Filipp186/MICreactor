.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
.coverage
.env
.env.*
!.env.example
*.log
*.key
*.pem
credentials.json
token.txt
.idea/
.vscode/
build/
dist/
installer-output/
vendor/models/*
!vendor/models/.gitkeep

# This checkout contains local work alongside the public documentation.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/QT_LGPL_COMPLIANCE.md
!/README.md
!/THIRD_PARTY_NOTICES.md
!/docs/
/docs/*
!/docs/PUBLICATION.md
!/docs/USER_GUIDE_RU.md
!/docs/VOICE_PROFILES_RU.md
!/docs/RELEASE_NOTES_[0-9]*_RU.md
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push
!/.githooks/check-public.py
